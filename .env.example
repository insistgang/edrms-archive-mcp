# 服务基础端口
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# 鸿翼 EDRMS 后端配置（联调地址）
EDRMS_BASE_URL=
EDRMS_TIMEOUT_SECONDS=8.0

# AUTO：未配置地址时用 Mock，已配置地址则失败报错；MOCK：演示；LIVE：实机
RUN_MODE=LIVE

# 客户私有化 LLM 接口配置（若留空则自动启用规则模板防幻觉生成引擎）
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=qwen-max
LLM_GENERATE_MSG=false
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# 审计日志路径（留空表示不落盘）。写入内容不含令牌与原文，仅含用户令牌指纹、工具与结果条数
EDRMS_AUDIT_LOG=

# 跨域来源（留空表示同源访问，禁止使用通配符）
MCP_ALLOW_CORS_ORIGIN=

# 外部 OCR 命令（图片/扫描件识别），例如：tesseract {path} stdout
MCP_OCR_COMMAND=
MCP_OCR_TIMEOUT_SECONDS=60
